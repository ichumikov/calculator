{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Calculator",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/igor/calculator/build/calculator",
            "args": [],
            "stopAtEntry": false,
            "cwd": "/home/igor/calculator",
            "environment": [
                { "name": "CALC_INPUT", "value": "{\"a\":10,\"op\":\"-\",\"b\":5}" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}