{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Calculator",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/calculator",
            "args": ["{\"a\": 10, \"op\": \"+\", \"b\": 5}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
